rules_version = '2';

// iEye — web-app Firestore security rules.
//
// The payments + contribution subsystem was removed (iEye takes no donations),
// so the contributions / publicSupporters / contributorRequests collections and
// the admin custom-claim model are gone. What remains is the per-user profile /
// early-access waitlist doc (captured from the Google sign-in), plus default-deny
// for everything else. Rules protect data even if the frontend is fully
// compromised: a client can only ever touch its own user doc.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Defense-in-depth: no rule here trusts an authz field on a user doc, but we
    // still refuse to let a client PERSIST one (admin/role/claims/…), so a future
    // rule or backend can never mistake a spoofed field for authorization.
    function hasNoAuthzFields() {
      return !request.resource.data.keys().hasAny(
        ['admin', 'isAdmin', 'role', 'roles', 'claims', 'customClaims']
      );
    }

    // users — profile + early-access waitlist (name/email/consent), one doc per
    // uid. The owner reads/writes ONLY their own doc; no one can read or write
    // another user's, and no client may write an authz-looking field.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && hasNoAuthzFields();
    }

    // Everything else is denied for all clients. Trusted backend via the Admin
    // SDK bypasses rules entirely and is governed by its own threat model.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
