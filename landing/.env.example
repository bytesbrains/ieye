# iEye web app — environment template (Phase 1.5, #43)
#
# Copy to `.env` (gitignored) and fill in for a REAL Firebase project (#42).
# For LOCAL DEVELOPMENT against the Firebase emulator you do NOT need a real
# project: keep VITE_USE_EMULATOR=true and the demo placeholders below — the
# emulator ignores the API key / project specifics.
#
# All client Firebase config values are PUBLIC by design (they identify the
# project; they are not cryptographic secrets) — but real secrets (payment
# keys, admin credentials) must NEVER live here; they belong in Cloud
# Functions / a secret manager. See #43 "Security & privacy (CISO gate)".

# ---- Emulator switch ----
# true  -> connect Auth + Firestore to the local emulators (dev, no real project)
# false -> connect to the real Firebase project configured below
VITE_USE_EMULATOR=true

# ---- Firebase web config (real project — #42) ----
# When VITE_USE_EMULATOR=true these only need to be syntactically present;
# a throwaway "demo-" project id makes the emulator happy with zero setup.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-ieye.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-ieye
VITE_FIREBASE_STORAGE_BUCKET=demo-ieye.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ---- Emulator ports (must match landing/firebase.json) ----
VITE_EMULATOR_AUTH_URL=http://127.0.0.1:9099
VITE_EMULATOR_FIRESTORE_HOST=127.0.0.1
VITE_EMULATOR_FIRESTORE_PORT=8080
