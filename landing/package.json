{
  "name": "ieye-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "iEye Phase-1 public landing page — hope-first welfare app on the Maktub Protocol.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-ieye",
    "emulators:seed": "firebase emulators:start --only auth,firestore --project demo-ieye --import ./.emulator-seed --export-on-exit ./.emulator-seed",
    "grant-admin": "node scripts/grant-admin.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "firebase-tools": "^15.22.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^8.1.0"
  }
}
