{
  "name": "ieye-firestore-rules-tests",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Emulator-backed unit tests for iEye Firestore security rules (#43). No real Firebase project required.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project ieye-rules-test 'vitest run'",
    "test:watch": "firebase emulators:exec --only firestore --project ieye-rules-test 'vitest'",
    "emulators": "firebase emulators:start --only firestore,auth --project ieye-rules-test"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^15.22.3",
    "vitest": "^4.1.9"
  }
}
